{
  "description": "ZCode 实时速度方框：会话启动时幂等拉起本地服务，以及已装 Electron 运行时的桌面浮层；每次提问时记下「本问」时刻（供 --current 守卫）。可在 ~/.zcode/tps/config.json 里把 autoStartWidget / autoStartOverlay 设为 false 关闭自启。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/lib/autostart.mjs"
            ],
            "timeoutMs": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/lib/prompt-submit.mjs"
            ],
            "timeoutMs": 5000
          }
        ]
      }
    ]
  }
}
